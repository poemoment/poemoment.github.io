---
import type { MarkdownHeading } from 'astro'
import { generateToc } from './toc'
import TOCHeading from './TOCHeading.astro'

interface Props {
  headings: MarkdownHeading[]
  class?: string
  id?: string
}

const { headings, class: className, ...props } = Astro.props
const toc = generateToc(headings)
const isEn = Astro.url.pathname.startsWith('/en')
---

{toc.length > 0 && (
  <toc-heading class={className} {...props}>
    <h2 class='font-semibold'>{isEn ? 'TABLE OF CONTENTS' : '目录'}</h2>
    <nav aria-label={isEn ? 'Table of contents' : '文章目录'}>
      <ul class='mt-4 text-card-foreground'>
        {toc.map((heading) => <TOCHeading heading={heading} />)}
      </ul>
    </nav>
  </toc-heading>
)}

<script>
  class TOC extends HTMLElement {
    links: { element: HTMLAnchorElement; heading: HTMLElement }[] = []
    frame = 0
    controller?: AbortController
    resizeObserver?: ResizeObserver

    connectedCallback() {
      this.controller = new AbortController()
      const { signal } = this.controller
      this.links = Array.from(this.querySelectorAll<HTMLAnchorElement>('a[href^="#"]'))
        .flatMap((element) => {
          const heading = document.getElementById(decodeURIComponent(element.hash.slice(1)))
          return heading && document.querySelector('#content')?.contains(heading)
            ? [{ element, heading }] : []
        })
      this.links.forEach(({ element, heading }) => {
        element.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return
          event.preventDefault()
          history.pushState(null, '', element.hash)
          // After the mobile disclosure closes, measure and move to the real heading.
          requestAnimationFrame(() => {
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
              || document.documentElement.dataset.motion === 'off'
            if (!heading.hasAttribute('tabindex')) {
              heading.setAttribute('tabindex', '-1')
              heading.addEventListener('blur', () => heading.removeAttribute('tabindex'), { once: true })
            }
            heading.focus({ preventScroll: true })
            heading.scrollIntoView({ behavior: reduced ? 'instant' : 'smooth', block: 'start' })
          })
        }, { signal })
      })
      window.addEventListener('scroll', this.scheduleUpdate, { passive: true, signal })
      window.addEventListener('resize', this.scheduleUpdate, { signal })
      const content = document.querySelector('#content')
      if (content) {
        this.resizeObserver = new ResizeObserver(this.scheduleUpdate)
        this.resizeObserver.observe(content)
      }
      this.scheduleUpdate()
    }

    scheduleUpdate = () => {
      if (this.frame) return
      this.frame = requestAnimationFrame(() => {
        this.frame = 0
        let current = this.links[0]
        for (const link of this.links) {
          if (link.heading.getBoundingClientRect().top <= 128) current = link
          else break
        }
        this.links.forEach((link) => {
          const active = link === current
          link.element.classList.toggle('highlight', active)
          link.element.classList.toggle('highlight-bg-translucent', active)
          if (active) link.element.setAttribute('aria-current', 'location')
          else link.element.removeAttribute('aria-current')
        })
      })
    }

    disconnectedCallback() {
      this.controller?.abort()
      this.resizeObserver?.disconnect()
      cancelAnimationFrame(this.frame)
      this.frame = 0
    }
  }
  if (!customElements.get('toc-heading')) customElements.define('toc-heading', TOC)
</script>

<style>
  toc-heading { display: block; }
  toc-heading :global(.toc-item) {
    display: block;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  toc-heading :global(.toc-item:focus-visible) {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 2px;
  }
</style>
