---
import { getLangFromUrl, localizedPath, useTranslations, type Lang } from '@/i18n/ui'

import { Icon } from 'astro-pure/user'
import LanguageSwitcher from '@/components/LanguageSwitcher.astro'
import config from '@/site-config'

interface Props {
  lang?: Lang
}

const lang = (Astro.props.lang ?? getLangFromUrl(Astro.url)) as Lang
const t = useTranslations(lang)

const menuKeyMap: Record<string, Parameters<typeof t>[0]> = {
  '/blog': 'nav.blog',
  '/archive': 'nav.notes',
  '/curated': 'nav.curated',
  '/projects': 'nav.projects',
  '/links': 'nav.links',
  '/about': 'nav.about',
  '/contact': 'nav.contact'
}

const menu = (config.header?.menu ?? []).map((item) => {
  const key = menuKeyMap[item.link.replace(/\/+$/, '')]
  return {
    title: key ? t(key) : item.title,
    link: localizedPath(item.link, lang)
  }
})

const homeHref = localizedPath('/', lang)
const searchHref = localizedPath('/search', lang)
---

<header-component
  class='group sticky top-4 z-[70] mb-6 flex items-center justify-between rounded-2xl border border-transparent max-md:py-1'
>
  <a
    class='brand z-30 text-xl font-semibold group-[.not-top]:ms-2 md:group-[.not-top]:ms-3'
    style='transition:margin-inline 0.3s'
    href={homeHref}
    aria-label='Brand'>{config.title}</a
  >

  <div class='flex items-center gap-x-2'>
    {/* Menu links */}
    <div
      id='headerExpandContent'
      class='end-0 start-0 top-12 grid border border-transparent group-[.not-top]:rounded group-[.expanded]:opacity-100 dark:group-[.expanded.not-top]:bg-muted max-md:absolute max-md:opacity-0 max-md:group-[.not-top]:border-border max-md:group-[.expanded.not-top]:bg-background max-md:group-[.not-top]:px-4 max-md:group-[.not-top]:py-2 md:grid-rows-1'
    >
      <div class='flex flex-col items-center justify-center overflow-hidden md:flex-row'>
        {
          menu.map((item) => (
            <a
              href={item.link}
              class='w-full flex-none grow py-2 text-right font-medium transition-none hover:text-primary md:w-fit md:px-3'
              data-nav-item
            >
              {item.title}
            </a>
          ))
        }
        <div class='flex w-full grow flex-row justify-end gap-x-3 md:w-fit md:gap-x-5'>
          <a class='px-1 py-2 transition-none md:px-2' href={searchHref} title={t('nav.search')}>
            <span class='sr-only'>{t('nav.search')}</span>
            <Icon name='search' class='size-5' />
          </a>
        </div>
      </div>
    </div>

    {/* buttons */}
    <div class='z-30 flex gap-x-2' style='transition:gap 0.3s'>
      <LanguageSwitcher lang={lang} />
      <button
        id='toggleDevMode'
        class='group/dev box-content h-5 rounded border p-1.5 font-mono text-xs leading-5 tracking-tight text-muted-foreground transition-colors hover:bg-border hover:text-primary md:group-[.not-top]:rounded'
        aria-label='Enter dev mode'
        title='dev mode (press `)'
      >
        <span aria-hidden='true'>$_</span>
      </button>
      <button
        id='toggleDarkMode'
        class='group/dark box-content size-5 rounded border p-1.5 transition-colors hover:bg-border md:group-[.not-top]:rounded'
      >
        <span class='sr-only'>{t('nav.toggleDarkMode')}</span>
        <Icon class='system size-5 group-hover/dark:text-primary' name='computer' />
        <Icon class='light hidden size-5 group-hover/dark:text-primary' name='sun' />
        <Icon class='dark hidden size-5 group-hover/dark:text-primary' name='moon' />
      </button>
      <button
        id='toggleMenu'
        class='rounded border p-1.5 transition-colors hover:bg-border md:hidden md:group-[.not-top]:rounded'
        aria-controls='headerExpandContent'
        aria-expanded='false'
      >
        <span class='sr-only'>{t('nav.toggleMenu')}</span>
        <Icon class='size-5' name='menu' />
      </button>
    </div>
  </div>
</header-component>

{/* Use inline to load icon quicker firstly */}
<script is:inline>
  const toggleDarkModeElement = document.getElementById('toggleDarkMode')
  if (toggleDarkModeElement) {
    toggleDarkModeElement.dataset.theme = localStorage.getItem('theme') || 'system'
  }
</script>
<script>
  import { setTheme, showToast } from 'astro-pure/utils'

  class Header extends HTMLElement {
    private toggleMenuBtn: HTMLElement | null = null

    constructor() {
      super()
    }

    private setMenuExpanded(expanded: boolean) {
      this.classList.toggle('expanded', expanded)
      this.toggleMenuBtn?.setAttribute('aria-expanded', expanded.toString())
    }

    private handleDocumentPointerDown = (event: PointerEvent) => {
      if (!this.classList.contains('expanded')) return

      const target = event.target
      if (!(target instanceof Element)) return

      if (!this.contains(target)) {
        this.setMenuExpanded(false)
        return
      }

      if (target.closest('a, button')) return

      this.setMenuExpanded(false)
    }

    private handleKeyDown = (event: KeyboardEvent) => {
      if (event.key !== 'Escape' || !this.classList.contains('expanded')) return
      this.setMenuExpanded(false)
      this.toggleMenuBtn?.focus()
    }

    connectedCallback() {
      let preScrollY = window.scrollY
      this.classList.toggle('not-top', preScrollY > 20)
      window.addEventListener('scroll', () => {
        this.classList.toggle('not-top', window.scrollY > 20)
        this.dataset.show = (window.scrollY < 350 || window.scrollY < preScrollY).toString()
        preScrollY = window.scrollY
      })

      const darkModeBtn = this.querySelector('#toggleDarkMode') as HTMLElement
      darkModeBtn.addEventListener('click', () => {
        const newTheme = setTheme(undefined, true)
        darkModeBtn.dataset.theme = newTheme
        showToast({ message: `Set theme to ${newTheme}` })
      })

      this.querySelector('#toggleDevMode')?.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('template:toggle-dev'))
      })

      this.toggleMenuBtn = this.querySelector('#toggleMenu')
      this.toggleMenuBtn?.addEventListener('click', () => {
        this.setMenuExpanded(!this.classList.contains('expanded'))
      })

      document.addEventListener('pointerdown', this.handleDocumentPointerDown)
      this.addEventListener('keydown', this.handleKeyDown)
    }

    disconnectedCallback() {
      document.removeEventListener('pointerdown', this.handleDocumentPointerDown)
      this.removeEventListener('keydown', this.handleKeyDown)
    }
  }

  customElements.define('header-component', Header)
</script>

<style>
  header-component {
    /* Keep navigation legible over the illustration; hide on downward scroll. */
    padding: 0.65rem 0.85rem;
    background: hsl(var(--card) / 0.96);
    border-color: hsl(var(--border) / 0.65);
    box-shadow: 0 8px 28px -20px hsl(var(--foreground) / 0.18);
    backdrop-filter: blur(14px);
    transition:
      padding 0.3s,
      transform 0.3s,
      margin-inline 0.3s,
      border 0.15s,
      background-color 0.15s;

    &.not-top {
      --un-border-opacity: 1;
      border-color: hsl(var(--border) / var(--un-border-opacity));
      --un-bg-opacity: 1;
      /* 实底 bg-card:背景是照片,滚动态导航文字必须有衬底 */
      background-color: hsl(var(--card) / var(--un-bg-opacity));
      padding-left: 0.375rem;
      padding-right: 0.375rem;
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }
    &[data-show='false']:not(.expanded) {
      transform: translateY(-5rem);
    }
  }
  .brand {
    font-family: var(--font-sans);
    font-weight: 750;
    letter-spacing: -0.045em;
  }
  #headerExpandContent a {
    font-size: 0.85rem;
  }
  :global(.dark) header-component.not-top {
    background-color: hsl(var(--card));
  }

  /* header menu */
  @media (max-width: 767px) {
    #headerExpandContent {
      top: calc(100% + 0.5rem);
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        opacity 0.3s,
        padding 0.3s,
        border-color 0.15s,
        grid-template-rows 0.3s;
    }
    .expanded #headerExpandContent {
      grid-template-rows: 1fr;
      visibility: visible;
      padding: 0.65rem 1rem;
      border-radius: 1rem;
      background: hsl(var(--card));
      border-color: hsl(var(--border));
    }
    .expanded.not-top #headerExpandContent {
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.08) 0px 0px 0px 1px,
        rgba(39, 39, 42, 0.08) 0px 10px 15px -3px,
        rgba(39, 39, 42, 0.08) 0px 4px 6px -4px;
    }
  }

  /* dark light mode toggle */
  #toggleDarkMode {
    &[data-theme='dark'] {
      & .system {
        display: none;
      }
      & .dark {
        display: block;
      }
    }
    &[data-theme='light'] {
      & .system {
        display: none;
      }
      .light {
        display: block;
      }
    }
  }
</style>
