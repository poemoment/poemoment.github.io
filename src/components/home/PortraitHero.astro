---
import { portraitArt } from '@/data/portrait-art'

import SakuraPetals from '@/components/SakuraPetals.astro'

const light = portraitArt.find((art) => art.id === 'rain')!
const dark = portraitArt.find((art) => art.id === 'night')!
---

<section class='portrait-hero' aria-labelledby='home-title'>
  <SakuraPetals />
  <div class='portrait-copy' data-motion-reveal>
    <span class='portrait-eyebrow'><span aria-hidden='true'>✦</span> LEARN · BUILD · DAYDREAM</span>
    <h1 id='home-title'>poemoment<span>.</span></h1>
    <p class='portrait-tagline'>记录学习，<br />也收藏沿途的晴空。</p>
    <p class='portrait-intro'>把零散的好奇写成笔记，<br />在代码与日常之间，留一点发呆的时间。</p>
    <div class='portrait-actions'>
      <a class='portrait-primary' href='/archive/'>翻开笔记 <span aria-hidden='true'>↗</span></a>
      <a href='/projects/'>看看项目 <span aria-hidden='true'>→</span></a>
    </div>
    <a class='portrait-gallery-link' href='#portrait-gallery'>
      <span class='portrait-line' aria-hidden='true'></span>沿途的风景 <span aria-hidden='true'
        >↓</span
      >
    </a>
  </div>
  <div class='portrait-stage' data-hero-parallax>
    <span class='portrait-orbit' aria-hidden='true'></span>
    <figure class='portrait-mat' data-parallax-image>
      <div class='portrait-image-wrap'>
        <img
          class='portrait-day'
          src={light.src}
          width={light.width}
          height={light.height}
          alt={light.alt}
          fetchpriority='high'
          decoding='async'
        />
        <img
          class='portrait-night'
          src={dark.src}
          width={dark.width}
          height={dark.height}
          alt={dark.alt}
          decoding='async'
        />
      </div>
      <figcaption>
        <span class='portrait-day'>雨后的晴空</span><span class='portrait-night'>山间星夜</span
        ><span class='portrait-caption-en'>A MOMENT, KEPT.</span>
      </figcaption>
    </figure>
    <span class='portrait-side-note' aria-hidden='true'>COLLECT THE ORDINARY · 01</span>
  </div>
</section>

<style>
  .portrait-hero {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 560px;
    padding: 2rem 2.5rem;
    border: 1px solid hsl(var(--border) / 0.65);
    border-radius: 1.6rem;
    background: linear-gradient(125deg, hsl(var(--card) / 0.98), hsl(var(--card) / 0.86));
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .portrait-copy {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding-block: 1rem;
  }
  .portrait-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font: 0.6rem var(--font-mono);
    letter-spacing: 0.18em;
    color: hsl(var(--primary));
  }
  .portrait-eyebrow > span {
    font-size: 1.1rem;
    color: #cb85a6;
  }
  h1 {
    margin: 1.35rem 0 0.8rem;
    font: 750 clamp(2.4rem, 5.7vw, 4.25rem) / 1.08 var(--font-sans);
    letter-spacing: -0.065em;
  }
  h1 > span {
    color: #c981a2;
  }
  .portrait-tagline {
    margin: 0;
    font: 500 clamp(1.2rem, 2.3vw, 1.65rem) / 1.7 var(--font-serif);
    letter-spacing: 0.04em;
  }
  .portrait-intro {
    margin: 1.4rem 0 0;
    font-size: 0.84rem;
    line-height: 1.9;
    color: hsl(var(--muted-foreground));
  }
  .portrait-actions {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }
  .portrait-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
    min-height: 44px;
    padding: 0.7rem 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.75rem;
    font-size: 0.8rem;
    transition: background 0.2s;
  }
  .portrait-actions a:hover {
    background: hsl(var(--primary) / 0.12);
  }
  .portrait-actions .portrait-primary {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    border-color: transparent;
  }
  .portrait-actions .portrait-primary:hover {
    background: hsl(var(--primary) / 0.86);
  }
  .portrait-gallery-link {
    display: inline-flex;
    gap: 0.65rem;
    align-items: center;
    min-height: 44px;
    margin-top: 1.65rem;
    font: 0.68rem var(--font-mono);
    color: hsl(var(--muted-foreground));
  }
  .portrait-line {
    width: 2rem;
    height: 1px;
    background: hsl(var(--primary) / 0.45);
  }
  .portrait-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 500px;
    padding: 1rem 1.6rem;
  }
  .portrait-orbit {
    position: absolute;
    width: 90%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid hsl(var(--primary) / 0.14);
    background: radial-gradient(circle, hsl(var(--primary) / 0.09), transparent 70%);
    transform: translateY(2rem);
    pointer-events: none;
  }
  .portrait-mat {
    position: relative;
    width: 100%;
    max-width: 370px;
    margin: 0;
    padding: 0.6rem 0.6rem 0;
    background: hsl(var(--card));
    border: 1px solid hsl(var(--border) / 0.8);
    border-radius: 0.5rem;
    box-shadow: 0 18px 50px -26px hsl(220 45% 30%/0.5);
    translate: var(--hero-parallax-x, 0px) var(--hero-parallax-y, 0px);
  }
  [data-parallax-enabled] .portrait-mat {
    transition: translate 380ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .portrait-image-wrap {
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 0.2rem;
  }
  .portrait-image-wrap img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  .portrait-night {
    display: none !important;
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 2.8rem;
    padding: 0.6rem 0.35rem;
    font: 0.62rem var(--font-mono);
    color: hsl(var(--muted-foreground));
  }
  .portrait-caption-en {
    font-size: 0.5rem;
    letter-spacing: 0.1em;
  }
  .portrait-side-note {
    position: absolute;
    right: 0;
    top: 50%;
    writing-mode: vertical-rl;
    font: 0.52rem var(--font-mono);
    letter-spacing: 0.2em;
    color: hsl(var(--muted-foreground));
    opacity: 0.7;
  }
  :global(html.dark) .portrait-day {
    display: none !important;
  }
  :global(html.dark) .portrait-night {
    display: block !important;
  }
  :global(html.dark) .portrait-mat {
    max-width: 292px;
    box-shadow: 0 18px 50px -22px hsl(250 65% 5%/0.8);
  }
  :global(html.dark) .portrait-orbit {
    border-color: hsl(var(--primary) / 0.2);
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .portrait-hero {
      padding: 1.5rem;
      grid-template-columns: 1fr 0.9fr;
      gap: 0.5rem;
      min-height: 500px;
    }
    .portrait-stage {
      padding: 1rem;
      min-height: 430px;
    }
    .portrait-eyebrow {
      letter-spacing: 0.05em;
      font-size: 0.53rem;
    }
    h1 {
      font-size: clamp(2.2rem, 5.6vw, 3.3rem);
    }
  }
  @media (max-width: 767px) {
    .portrait-hero {
      grid-template-columns: 1fr;
      padding: 1.6rem 1.2rem 1rem;
      gap: 1rem;
      border-radius: 1.2rem;
    }
    .portrait-copy {
      padding: 0;
    }
    .portrait-eyebrow {
      font-size: 0.53rem;
      letter-spacing: 0.1em;
    }
    h1 {
      font-size: clamp(2.7rem, 10.7vw, 4rem);
      margin-top: 1rem;
    }
    .portrait-tagline {
      font-size: 1.3rem;
    }
    .portrait-tagline br {
      display: none;
    }
    .portrait-intro {
      margin-top: 0.7rem;
    }
    .portrait-actions {
      margin-top: 1.1rem;
    }
    .portrait-gallery-link {
      margin-top: 0.6rem;
    }
    .portrait-stage {
      min-height: 0;
      padding: 0 1.4rem 1rem;
    }
    .portrait-mat {
      max-width: 300px;
    }
    .portrait-image-wrap img {
      max-height: 48svh;
      width: auto;
      max-width: 100%;
    }
    .portrait-image-wrap {
      background: hsl(var(--background));
    }
    .portrait-side-note {
      right: 0.15rem;
    }
    :global(html.dark) .portrait-mat {
      max-width: 258px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .portrait-mat {
      translate: none !important;
      transition: none !important;
    }
    .portrait-actions a {
      transition: none;
    }
  }
</style>
