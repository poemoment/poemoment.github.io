---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import type { iconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'

import '@/assets/styles/project-stack.css'

interface Props {
  class?: string
  project: {
    image?: string
    name: string
    description: string
    /** 项目状态小字(如「开发中 · 暂未开源」);无链接的项目用它交代去向 */
    status?: string
    links: {
      type: string
      href: string
    }[]
  }[]
}
const { class: className, project, ...props } = Astro.props
const hasStack = project.length > 1
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*.{jpeg,jpg,png,gif}'
)
const projectIconSet: Record<string, iconsType> = {
  github: 'github-circle',
  site: 'earth',
  doc: 'document',
  release: 'package'
}
---

<div class={className} {...props}>
  <div
    class='project-stack grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2 sm:gap-y-4'
    data-project-stack={hasStack ? '' : undefined}
  >
    {
      project.map((project, index) => {
        var imagePath = null
        if (project.image) {
          imagePath = '/src/assets/projects/' + project.image
          if (!images[imagePath])
            throw new Error(
              `"${imagePath}" does not exist in glob: "src/assets/projects/*.{jpeg,jpg,png,gif}"`
            )
        }

        return (
          <div class='project-stack-item' data-project-stack-item>
            <div
              class='project-card motion-card relative overflow-hidden rounded-xl border'
              data-motion-surface
              data-motion-reveal
            >
              <span class='project-card-accent' aria-hidden='true' />
              {imagePath && (
                <Image
                  class='absolute end-0 z-0 m-0 h-full w-1/2 object-cover opacity-40'
                  src={images[imagePath]()}
                  alt={project.name}
                  loading='lazy'
                  style={{
                    maskImage:
                      'linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%)',
                    msMaskImage:
                      '-ms-linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%)',
                    WebkitMaskImage:
                      '-webkit-linear-gradient(to right, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 1) 100%)'
                  }}
                />
              )}
              <div
                class={cn(
                  'project-card-content relative z-10 flex flex-col gap-y-3',
                  imagePath && 'me-20'
                )}
              >
                <div class='project-card-heading'>
                  <span class='project-card-number' aria-hidden='true'>
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class='project-card-identity'>
                    <h3 class='project-card-title'>
                      {project.links.length > 0 ? (
                        <a
                          class='project-title text-foreground no-underline transition-colors'
                          href={project.links[0].href}
                          target={/^https?:\/\//.test(project.links[0].href) ? '_blank' : undefined}
                          rel={
                            /^https?:\/\//.test(project.links[0].href)
                              ? 'noopener noreferrer'
                              : undefined
                          }
                        >
                          {project.name}
                        </a>
                      ) : (
                        <span class='project-title text-foreground'>{project.name}</span>
                      )}
                    </h3>
                    {project.status && <span class='project-status'>{project.status}</span>}
                  </div>
                </div>
                <div class='project-description text-muted-foreground'>{project.description}</div>
                {project.links.length > 0 && (
                  <div class='project-card-links flex flex-row items-center gap-x-2 sm:gap-x-3'>
                    {project.links.map((link) => {
                      const icon = projectIconSet[link.type]
                      return (
                        <a
                          href={link.href}
                          class='project-card-link text-muted-foreground transition-colors'
                          aria-label={`${project.name} · ${link.type}`}
                          target={/^https?:\/\//.test(link.href) ? '_blank' : undefined}
                          rel={/^https?:\/\//.test(link.href) ? 'noopener noreferrer' : undefined}
                        >
                          <Icon class='size-5' name={icon} />
                        </a>
                      )
                    })}
                  </div>
                )}
              </div>
            </div>
          </div>
        )
      })
    }
  </div>
</div>

<style>
  .project-card-heading {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .project-card-identity {
    min-width: 0;
    flex: 1;
  }
  .project-card-heading .project-card-title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.025em;
  }
  .project-card-title > a.project-title {
    font: inherit;
    width: 100%;
    margin: 0;
    padding: 0;
    opacity: 1;
  }
  .project-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    word-break: break-word;
  }
  .project-status {
    display: block;
    margin-top: 0.3rem;
    color: hsl(var(--primary));
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .project-description {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    word-break: break-word;
    line-height: 1.7;
  }
  @media (max-width: 1023px) {
    .project-title {
      display: block;
      -webkit-line-clamp: unset;
      line-clamp: unset;
      overflow: visible;
    }
  }
</style>
