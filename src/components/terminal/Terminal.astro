---
import TerminalShell from './TerminalShell'
import { buildSiteFs } from './fs/server'

const fs = await buildSiteFs()
---

<div class='wt-intro' aria-hidden='true'>
  <span class='wt-intro-tag'>// terminal hero</span>
  <span class='wt-intro-text'>
    Open the shell to preview the terminal interaction layer. Try <code>help</code>,
    <code>chat</code>, or <code>ls /blog</code>.
  </span>
</div>
<TerminalShell client:load fs={fs} user='guest' host='local-site' />
