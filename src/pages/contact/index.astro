---
import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'channels', text: 'Channels' },
  { depth: 2, slug: 'before-writing', text: 'Before Writing' }
]

const channels = [
  {
    name: 'Email',
    href: 'mailto:hello@example.com',
    email: 'hello@example.com',
    note: 'Replace this with your public email address.'
  },
  {
    name: 'GitHub',
    href: 'https://github.com/yourname',
    note: 'Replace this with your GitHub profile.'
  },
  {
    name: 'Personal link',
    href: 'https://example.com',
    note: 'Use this for a newsletter, calendar, or social profile.'
  }
]
---

<PageLayout title='Contact' {headings} info='/contact'>
  <p>
    这里是公开联系页模板。发布前只放你愿意长期公开的信息；私人微信、QQ群、手机号、
    收款码等内容建议默认不要放进开源仓库。
  </p>

  <h2 id='channels'>Channels</h2>
  <ul>
    {
      channels.map((item) => (
        <li>
          <a href={item.href} target='_blank' rel='noreferrer'>{item.name}</a>
          {item.email && (
            <button class='copy-btn' type='button' data-copy-email={item.email}>
              <span aria-live='polite'>复制邮箱</span>
            </button>
          )}
          <span> - {item.note}</span>
        </li>
      ))
    }
  </ul>

  <h2 id='before-writing'>Before Writing</h2>
  <ul>
    <li>说明你是谁、从哪里看到这个网站，以及你想聊什么。</li>
    <li>商务、招聘、转载、合作请直接写清背景和期望。</li>
    <li>如果你还没准备好公开联系方式，可以先保留占位内容。</li>
  </ul>
</PageLayout>

{/* 视觉菜单 ②：点击复制 + 两态反馈（学自 rauno.me）。clipboard 不可用时提示手动复制。 */}
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
    const label = btn.querySelector('span')
    let timer: number | undefined
    btn.addEventListener('click', async () => {
      const email = btn.dataset.copyEmail ?? ''
      const ok = await navigator.clipboard
        .writeText(email)
        .then(() => true)
        .catch(() => false)
      if (!label) return
      window.clearTimeout(timer)
      label.textContent = ok ? '已复制' : '复制失败，请手动选择'
      btn.dataset.copied = String(ok)
      timer = window.setTimeout(() => {
        label.textContent = '复制邮箱'
        delete btn.dataset.copied
      }, 1600)
    })
  })
</script>

<style>
  .copy-btn {
    margin-left: 0.6rem;
    padding: 0.1rem 0.65rem;
    border: 1px solid hsl(var(--border));
    border-radius: 4px;
    background: transparent;
    color: hsl(var(--muted-foreground));
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .copy-btn:hover,
  .copy-btn[data-copied='true'] {
    border-color: hsl(var(--primary));
    color: hsl(var(--primary));
  }
</style>
