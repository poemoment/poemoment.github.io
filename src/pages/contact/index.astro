---
import { profileLinks } from '@/data/profile'

import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'channels', text: '公开入口' },
  { depth: 2, slug: 'before-writing', text: '反馈说明' }
]

const channels = [
  { name: 'GitHub 主页', href: profileLinks.github, note: '查看我的公开账号与仓库。' },
  { name: '博客问题反馈', href: profileLinks.issues, note: '报告失效链接、页面问题或内容错误。' },
  { name: '个人博客', href: '/', note: '返回首页，浏览文章、随记与收藏。' },
  { name: 'RSS 订阅', href: '/rss.xml', note: '通过阅读器订阅博客文章。' }
]
---

<PageLayout title='联系' {headings}>
  <p>目前通过 GitHub 提供公开反馈入口；博客相关问题请提交到本站仓库的 Issues。</p>

  <h2 id='channels'>公开入口</h2>
  <ul>
    {
      channels.map((item) => (
        <li>
          <a
            href={item.href}
            target={item.href.startsWith('https://') ? '_blank' : undefined}
            rel={item.href.startsWith('https://') ? 'noopener noreferrer' : undefined}
          >
            {item.name}
          </a>
          <span> — {item.note}</span>
        </li>
      ))
    }
  </ul>

  <h2 id='before-writing'>反馈说明</h2>
  <p>
    反馈时请附上相关页面链接、遇到的问题，以及方便复现的步骤；内容纠错可直接指出原文位置与参考来源。
  </p>
</PageLayout>
