---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import CgBackdrop from '@/components/home/CgBackdrop.astro'
import PFSearch from '@/components/search/PFSearch.astro'

const meta = {
  description: 'Search published posts, notes, and curated recommendations.',
  title: 'Search'
}
---

<PageLayout {meta}>
  <Button title='Back to home' href='/en/' style='back' />
  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <h1 class='mb-6 text-3xl font-medium'>Search</h1>
    </div>

    <div id='content' class='animate'>
      <p class='text-sm leading-7 text-muted-foreground'>
        Search published posts, notes, and curated recommendations. Most content is currently in
        Chinese; results link to the original version.
      </p>
      <PFSearch />
    </div>
    <CgBackdrop />
  </main>
</PageLayout>
