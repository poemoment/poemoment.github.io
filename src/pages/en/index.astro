---
import { getCollection, render } from 'astro:content'
import { siteColumnsEn } from '@/data/columns'
import { hasReadingTopics, readingTopics } from '@/data/reading'

import PageLayout from '@/layouts/BaseLayout.astro'
import AnimeHero from '@/components/home/AnimeHero.astro'
import CgBackdrop from '@/components/home/CgBackdrop.astro'
import ThoughtOrbit from '@/components/home/ThoughtOrbit.astro'

import '@/assets/styles/home.css'

export const prerender = true

/*
 * 英文首页与中文版共享插画和阅读卡片布局。
 * 内容回退规则：en 集合为空时显示中文集合的内容（链接指向中文路由），
 * 与 i18n 提示「界面已英文、内容翻译进行中」一致；不虚构内容。
 */

const enPosts = (await getCollection('blogEn', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)
const zhPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)
const useEnPosts = enPosts.length > 0
const allPosts = useEnPosts ? enPosts : zhPosts

// 视觉菜单 ⑧：置顶优先，其余按时间倒序
const recentPosts = [...allPosts]
  .sort((a, b) => {
    if (a.data.pin !== b.data.pin) return a.data.pin ? -1 : 1
    return b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
  })
  .slice(0, 7)

const posts = await Promise.all(
  recentPosts.map(async (post) => {
    const { remarkPluginFrontmatter } = await render(post)
    const minutes = Number.parseInt(String(remarkPluginFrontmatter.minutesRead), 10)
    return { post, minutes: Number.isNaN(minutes) ? null : minutes }
  })
)

const enArchive = (await getCollection('archiveEn', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)
const zhArchive = (await getCollection('archive', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)
const useEnArchive = enArchive.length > 0
const archiveEntries = useEnArchive ? enArchive : zhArchive
const curatedEntries = (await getCollection('curated', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
)

const postHref = (id: string) => (useEnPosts ? `/en/blog/${id}/` : `/blog/${id}/`)
const archiveHref = (id: string) => (useEnArchive ? `/en/archive/${id}/` : `/archive/${id}/`)

// 栏目索引：条目数与最新条目来自真实集合；blog/archive 在英文站回退中文集合时仍按真实数据计
const columnLatest: Record<
  string,
  { count?: number; unit?: string; latest?: { title: string; href: string } }
> = {
  blog: {
    count: allPosts.length,
    unit: 'posts',
    latest: allPosts[0] && { title: allPosts[0].data.title, href: postHref(allPosts[0].id) }
  },
  archive: {
    count: archiveEntries.length,
    unit: 'entries',
    latest: archiveEntries[0] && {
      title: archiveEntries[0].data.title,
      href: archiveHref(archiveEntries[0].id)
    }
  },
  curated: {
    count: curatedEntries.length,
    unit: 'entries',
    latest: curatedEntries[0] && {
      title: curatedEntries[0].data.title,
      href: `/curated/${curatedEntries[0].id}/`
    }
  }
}

// 左栏当前状态：最近一次更新发生在哪个集合
const recentActivity = [
  { label: 'post', date: allPosts[0]?.data.publishDate },
  { label: 'note', date: archiveEntries[0]?.data.date },
  { label: 'collection', date: curatedEntries[0]?.data.date }
]
  .filter((item): item is { label: string; date: Date } => Boolean(item.date))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())[0]

// 阶段字段的展示级翻译（reading.ts 数据本身保持中文）
const stageEn: Record<string, string> = {
  阅读: 'Reading',
  复现: 'Reproducing',
  实验: 'Experimenting',
  整理: 'Writing up'
}

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).format(date)
---

<PageLayout meta={{ title: 'Home' }}>
  <main class='home-shell' id='content-header'>
    <AnimeHero lang='en' />
    {/* Sidebar status and reading topics beside the latest writing. */}
    <section class='first-screen' aria-label='Recent posts and current status'>
      <div class='posts-col' id='content' data-motion-reveal>
        <div class='col-heading'>
          <h2>{posts.length ? 'Recent posts' : 'Recent notes'}</h2>
          <a href={posts.length ? '/en/blog/' : '/en/archive/'} class='col-more'>
            {posts.length ? `All ${allPosts.length} posts` : 'All notes'}
          </a>
        </div>
        {
          posts.length ? (
            <ol class='post-list'>
              {posts.map(({ post, minutes }) => (
                <li>
                  <a
                    class='post-row'
                    href={postHref(post.id)}
                    data-post-row={post.id}
                    data-published={post.data.publishDate.toISOString()}
                  >
                    <div class='post-main'>
                      <h3>
                        <span class='unread-dot' data-unread-dot hidden aria-hidden='true' />
                        {post.data.title}
                      </h3>
                      <p>{post.data.description}</p>
                      <p class='post-meta-line'>
                        {post.data.pin && (
                          <>
                            <span class='meta-pin'>Pinned</span>
                            <span class='meta-sep'>·</span>
                          </>
                        )}
                        <time
                          datetime={post.data.publishDate.toISOString()}
                          data-rel
                          title={formatDate(post.data.publishDate)}
                        >
                          {formatDate(post.data.publishDate)}
                        </time>
                        {minutes !== null && (
                          <>
                            <span class='meta-sep'>·</span>
                            <span>{minutes} min</span>
                          </>
                        )}
                        <span class='meta-sep'>·</span>
                        <span class='meta-tag'>{post.data.tags[0] ?? 'note'}</span>
                      </p>
                    </div>
                  </a>
                </li>
              ))}
            </ol>
          ) : (
            <div class='empty-state'>
              <p>
                {archiveEntries.length
                  ? 'Longer posts are in progress. Start with the latest notes.'
                  : 'No public posts yet. The first one will appear here.'}
              </p>
              <p class='empty-alt'>
                Meanwhile you can browse <a href='/en/archive/'>notes</a> and{' '}
                <a href='/en/curated/'>curated</a>.
              </p>
              <ol class='post-list latest-notes' data-home-notes>
                {archiveEntries.slice(0, 3).map((entry) => (
                  <li data-motion-reveal>
                    <a class='post-row' href={archiveHref(entry.id)}>
                      <div class='post-main'>
                        <span class='note-kind'>
                          Note<span aria-hidden='true'>↗</span>
                        </span>
                        <h3>{entry.data.title}</h3>
                        {entry.data.description && <p>{entry.data.description}</p>}
                        <p class='post-meta-line'>
                          <time datetime={entry.data.date.toISOString()} data-rel>
                            {formatDate(entry.data.date)}
                          </time>
                          {entry.data.tags[0] && (
                            <>
                              <span class='meta-sep'>·</span>
                              <span class='meta-tag'>{entry.data.tags[0]}</span>
                            </>
                          )}
                        </p>
                      </div>
                    </a>
                  </li>
                ))}
              </ol>
              {!useEnArchive && archiveEntries.length > 0 && (
                <p class='lang-fallback'>
                  Notes are shown in the original language while translation is in progress.
                </p>
              )}
              <ThoughtOrbit lang='en' />
            </div>
          )
        }
        {
          !useEnPosts && posts.length > 0 && (
            <p class='lang-fallback'>
              Posts are shown in the original language while translation is in progress.
            </p>
          )
        }
      </div>
      <div class='home-sidebar'>
        {
          hasReadingTopics && (
            <aside class='reading-col' aria-label='Topics under study'>
              <div class='col-heading'>
                <h2>Now understanding</h2>
              </div>
              <ul class='reading-list'>
                {readingTopics.map((topic) => (
                  <li data-motion-reveal>
                    {topic.href ? (
                      <a
                        class='reading-item'
                        href={topic.href}
                        {...(/^https?:\/\//.test(topic.href)
                          ? { target: '_blank', rel: 'noopener noreferrer' }
                          : {})}
                      >
                        <span class='reading-title'>{topic.title}</span>
                        <span class='reading-meta'>
                          <span class='reading-stage'>{stageEn[topic.stage] ?? topic.stage}</span>
                          <time datetime={topic.updated} data-rel title={topic.updated}>
                            {topic.updated}
                          </time>
                        </span>
                      </a>
                    ) : (
                      <div class='reading-item'>
                        <span class='reading-title'>{topic.title}</span>
                        <span class='reading-meta'>
                          <span class='reading-stage'>{stageEn[topic.stage] ?? topic.stage}</span>
                          <time datetime={topic.updated} data-rel title={topic.updated}>
                            {topic.updated}
                          </time>
                        </span>
                      </div>
                    )}
                    {topic.source && <p class='reading-source'>{topic.source}</p>}
                  </li>
                ))}
              </ul>
            </aside>
          )
        }
        <aside class='status-col' aria-label='Current status' data-motion-reveal>
          <h2 class='col-title'>Status</h2>
          {
            recentActivity && (
              <p class='status-row'>
                <span class='status-label'>Latest update</span>
                <span class='status-value'>
                  <time datetime={recentActivity.date.toISOString()} data-rel>
                    {formatDate(recentActivity.date)}
                  </time>
                  <span class='status-sep'>·</span>
                  {recentActivity.label}
                </span>
              </p>
            )
          }
          {
            hasReadingTopics && readingTopics[0] && (
              <p class='status-row'>
                <span class='status-label'>Now understanding</span>
                <span class='status-value'>{readingTopics[0].title}</span>
              </p>
            )
          }
          <p class='status-row'>
            <span class='status-label'>Subscribe</span>
            <span class='status-value'><a href='/rss.xml'>RSS</a></span>
          </p>
        </aside>
      </div>
    </section>

    {/* Second screen: section index (rows, not cards) */}
    <section class='column-index' aria-label='Section index'>
      <h2 class='col-title'>Sections</h2>
      <ul class='column-list'>
        {
          siteColumnsEn.map((column) => {
            const meta = column.collection ? columnLatest[column.collection] : undefined
            return (
              <li class='column-row motion-row' data-motion-reveal>
                <div class='column-name'>
                  <h3>{column.name}</h3>
                  {meta?.count !== undefined && meta.count > 0 && (
                    <span class='column-count'>
                      {meta.count} {column.unit || meta.unit}
                    </span>
                  )}
                </div>
                <div class='column-body'>
                  <p class='column-definition'>{column.definition}</p>
                  {meta?.latest && (
                    <a class='column-latest' href={meta.latest.href}>
                      Latest: {meta.latest.title}
                    </a>
                  )}
                </div>
                <a class='column-go' href={column.href}>
                  Browse
                </a>
              </li>
            )
          })
        }
      </ul>
    </section>
    <CgBackdrop interactive lang='en' />
  </main>

  {/* 视觉菜单 ⑫/⑬：相对时间 + 未读圆点（与中文首页同一套脚本，语言为 en-US） */}
  <script>
    const relUnits: Array<[Intl.RelativeTimeFormatUnit, number]> = [
      ['year', 31_536_000_000],
      ['month', 2_592_000_000],
      ['week', 604_800_000],
      ['day', 86_400_000],
      ['hour', 3_600_000],
      ['minute', 60_000]
    ]
    const fmt = new Intl.RelativeTimeFormat('en-US', { numeric: 'auto' })
    for (const el of document.querySelectorAll<HTMLTimeElement>('time[data-rel]')) {
      const ts = Date.parse(el.getAttribute('datetime') ?? '')
      if (Number.isNaN(ts)) continue
      const diff = ts - Date.now()
      const [unit, ms] = relUnits.find(([, span]) => Math.abs(diff) >= span) ?? relUnits.at(-1)!
      el.textContent = fmt.format(Math.round(diff / ms), unit)
    }

    const READ_KEY = 'poemoment:read-posts'
    const UNREAD_WINDOW_MS = 14 * 86_400_000
    let readSlugs: Set<string>
    try {
      readSlugs = new Set(JSON.parse(localStorage.getItem(READ_KEY) ?? '[]') as string[])
    } catch {
      readSlugs = new Set()
    }
    const persistRead = () => {
      try {
        localStorage.setItem(READ_KEY, JSON.stringify([...readSlugs]))
      } catch {
        /* private mode etc. — dots simply reappear next visit */
      }
    }
    document.querySelectorAll<HTMLAnchorElement>('[data-post-row]').forEach((row) => {
      const slug = row.dataset.postRow ?? ''
      const published = Date.parse(row.dataset.published ?? '')
      const isUnread =
        slug !== '' &&
        !Number.isNaN(published) &&
        Date.now() - published < UNREAD_WINDOW_MS &&
        !readSlugs.has(slug)
      const dot = row.querySelector<HTMLElement>('[data-unread-dot]')
      if (isUnread && dot) dot.hidden = false
      row.addEventListener('click', () => {
        if (!readSlugs.has(slug)) {
          readSlugs.add(slug)
          persistRead()
        }
      })
    })
  </script>
</PageLayout>
