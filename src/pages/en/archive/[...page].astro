---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { getCollection } from 'astro:content'
import { Paginator } from 'astro-pure/components/pages'
import { Button, Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const englishArchives = await getCollection('archiveEn', ({ data }) => !data.draft && Boolean(data.translationKey))
  const originalLanguage = englishArchives.length === 0
  const allArchives: CollectionEntry<'archive' | 'archiveEn'>[] = originalLanguage
    ? await getCollection('archive', ({ data }) => !data.draft)
    : englishArchives
  const sortedArchives = allArchives
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

  return paginate(sortedArchives, {
    pageSize: 20,
    props: { originalLanguage }
  })
}

interface Props {
  page: Page<CollectionEntry<'archive' | 'archiveEn'>>
  originalLanguage: boolean
}

const { page, originalLanguage } = Astro.props as unknown as Props

const allArchives = originalLanguage
  ? await getCollection('archive', ({ data }) => !data.draft)
  : await getCollection('archiveEn', ({ data }) => !data.draft && Boolean(data.translationKey))
const uniqueTags = [...new Set(allArchives.flatMap((entry) => entry.data.tags))].sort()
const uniqueStatuses = [...new Set(allArchives.map((entry) => entry.data.status))].sort()

const statusCounts = allArchives.reduce(
  (acc, entry) => {
    acc[entry.data.status] = (acc[entry.data.status] || 0) + 1
    return acc
  },
  {} as Record<string, number>
)

const meta = {
  description:
    'Learning notes and engineering retrospectives on AI agents, source code, and practical trade-offs.',
  title: page.currentPage === 1 ? 'Notes' : `Notes - Page ${page.currentPage}`
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: '← Previous',
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: 'Next →',
      url: page.url.next
    }
  })
}

const typeLabels: Record<string, string> = {
  note: 'Note',
  snippet: 'Snippet',
  draft: 'Draft',
  idea: 'Idea',
  research: 'Research',
  reference: 'Reference'
}

const statusLabels: Record<string, string> = {
  'in-progress': 'In progress',
  incomplete: 'Incomplete',
  ready: 'Writing complete',
  archived: 'Archived'
}

---

<PageLayout {meta}>
  <Button title='Back' href='/en/' style='back' />

  <main class='mt-6 lg:mt-10'>
    <div id='content-header' class='animate'>
      <div class='mb-3 flex items-center gap-3'>
        <div class='rounded-lg bg-muted/50 p-3'>
          <span class='text-2xl'>📒</span>
        </div>
        <div>
          <h1 class='text-3xl font-medium'>Notes</h1>
          <p class='text-sm text-muted-foreground'>First-hand notes · always growing</p>
        </div>
      </div>
      <p class='max-w-3xl text-muted-foreground'>
        Learning notes and engineering retrospectives on AI agents, source code, and practical trade-offs.
        Each note shows its writing status; evidence and limitations are described in the text.
      </p>
      {originalLanguage && page.total > 0 && (
        <p class='mt-4 max-w-3xl rounded-lg border border-border bg-card px-4 py-3 text-sm text-muted-foreground'>
          These notes are available in Chinese. The links below open the original text; English translations are not yet available.
        </p>
      )}
    </div>

    {
      page.data.length === 0 ? (
        <p class='mt-8'>No archive entries yet.</p>
      ) : (
        <div class='mt-10 grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8'>
          <section id='content' class='animate' aria-label='Archive entries'>
            <div class='mb-3 flex flex-col justify-between text-sm text-muted-foreground sm:mb-5 sm:flex-row'>
              <span>
                Showing {page.start + 1}-{page.end + 1} of {page.total}
              </span>
              {page.lastPage > 1 && (
                <span>
                  Page {page.currentPage} / {page.lastPage}
                </span>
              )}
            </div>

            <ul class='flex flex-col gap-y-4 text-start'>
              {page.data.map((entry) => (
                <li>
                  <a
                    href={entry.collection === 'archive' ? `/archive/${entry.id}/` : `/en/archive/${entry.data.translationKey}/`}
                    hreflang={entry.collection === 'archive' ? 'zh-CN' : 'en'}
                    class='group block rounded-xl border border-border bg-card px-5 py-5 transition hover:border-foreground/20 hover:shadow-sm'
                    data-astro-prefetch
                  >
                    <div class='flex flex-wrap items-start justify-between gap-4'>
                      <div class='min-w-0 flex-1 space-y-2'>
                        <h2 lang={originalLanguage ? 'zh-CN' : 'en'} class='text-lg font-medium leading-tight group-hover:text-foreground'>
                          {entry.data.title}
                        </h2>
                        {entry.data.description && (
                          <p lang={originalLanguage ? 'zh-CN' : 'en'} class='text-sm leading-6 text-muted-foreground'>
                            {entry.data.description}
                          </p>
                        )}

                        <div class='flex flex-wrap items-center gap-x-2 gap-y-2 text-xs text-muted-foreground'>
                          <span
                            class='rounded-md bg-muted px-2 py-0.5 font-medium'
                          >
                            {typeLabels[entry.data.type] || entry.data.type}
                          </span>
                          <span>·</span>
                          <time datetime={entry.data.date.toISOString()}>
                            {entry.data.date.toLocaleDateString('en', {
                              year: 'numeric',
                              month: 'short',
                              day: 'numeric',
                              timeZone: 'Asia/Shanghai'
                            })}
                          </time>
                          {entry.data.updatedDate && entry.data.updatedDate > entry.data.date && (
                            <span>
                              · updated{' '}
                              {entry.data.updatedDate.toLocaleDateString('en', {
                                year: 'numeric',
                                month: 'short',
                                day: 'numeric',
                                timeZone: 'Asia/Shanghai'
                              })}
                            </span>
                          )}
                          {entry.data.tags.length > 0 && (
                            <>
                              <span>·</span>
                              <div class='flex flex-wrap gap-1.5'>
                                {entry.data.tags.map((tag: string) => (
                                  <span class='rounded-md bg-muted px-2 py-0.5'>{tag}</span>
                                ))}
                              </div>
                            </>
                          )}
                        </div>
                      </div>

                      <span
                        class='mt-0.5 shrink-0 rounded-md bg-muted px-2 py-1 text-xs font-medium text-foreground'
                      >
                        {statusLabels[entry.data.status]}
                      </span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>

            {page.lastPage > 1 && (
              <div class='mt-8'>
                <Paginator {...paginationProps} />
              </div>
            )}
          </section>

          <aside class='animate' id='sidebar'>
            {!!uniqueTags.length && (
              <section class='mb-8'>
                <div class='mb-4 flex items-center justify-between'>
                  <h2 class='flex items-center text-lg font-semibold'>
                    <Icon name='tag-2' class='me-2' />
                    {originalLanguage ? 'Tags · Chinese archive' : 'Tags'}
                  </h2>
                  {originalLanguage && <a
                    href='/archive/tags/'
                    class='text-xs text-muted-foreground hover:text-foreground'
                  >
                    View all →
                  </a>}
                </div>
                <ul class='flex flex-wrap gap-2'>
                  {uniqueTags.map((tag) => (
                    <li>
                      {originalLanguage ? <a
                        href={`/archive/tags/${encodeURIComponent(tag)}/`}
                        class='inline-flex rounded-md border border-border px-2 py-1 text-xs transition hover:border-foreground/20'
                      >
                        {tag}
                      </a> : <span class='inline-flex rounded-md border border-border px-2 py-1 text-xs'>{tag}</span>}
                    </li>
                  ))}
                </ul>
              </section>
            )}

            <section>
              <h2 class='mb-4 flex items-center text-lg font-semibold'>
                <Icon name='list' class='me-2' />
                Status
              </h2>
              <ul class='space-y-2 text-sm'>
                {uniqueStatuses.map((status) => (
                  <li class='flex items-center justify-between gap-3'>
                    <span class='flex items-center gap-2'>
                      <span
                        class='inline-block size-2 rounded-full bg-primary'
                      />
                      <span class='text-foreground'>{statusLabels[status] || status}</span>
                    </span>
                    <span class='text-xs text-muted-foreground'>{statusCounts[status] || 0}</span>
                  </li>
                ))}
              </ul>
            </section>
          </aside>
        </div>
      )
    }
  </main>
</PageLayout>
