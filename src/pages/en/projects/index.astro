---
import { profileLinks } from '@/data/profile'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'building', text: 'In development' },
  { depth: 2, slug: 'featured', text: 'Public projects' },
  { depth: 2, slug: 'experiments', text: 'Explore this site' },
  { depth: 2, slug: 'credits', text: 'Open-source foundation' }
]
---

<PageLayout title='Projects' {headings}>
  <p>Things I am building, public work, and features you can try directly on this blog.</p>

  <h2 id='building'>In development</h2>
  <p class='text-sm text-muted-foreground'>
    Both projects run on my own machine every day and are built pair-programming with AI — I set the
    direction and acceptance criteria, coding agents do the implementation and tests. Source not
    public yet.
  </p>
  <ProjectSection
    project={[
      {
        name: 'personal-assistant',
        status: 'In development · not open-sourced',
        description:
          'A local personal assistant desktop app that grows with you: schedules, plans, reminders, learning and reading. FastAPI + Tauri, 557 tests.',
        links: []
      },
      {
        name: 'dsh-memory',
        status: 'In development · not open-sourced',
        description:
          'A long-term memory MCP server for any agent host: write gate, enforced evidence, correction chains, zero-token retrieval. 156 tests.',
        links: []
      }
    ]}
  />

  <h2 id='featured'>Public projects</h2>
  <ProjectSection
    project={[
      {
        name: 'poemoment · Personal blog',
        description:
          'An Astro blog for technical learning, practical work, and thinking in public, with source code on GitHub.',
        links: [
          { type: 'site', href: `${profileLinks.website}en` },
          { type: 'github', href: profileLinks.repository }
        ]
      }
    ]}
  />

  <h2 id='experiments'>Explore this site</h2>
  <ProjectSection
    project={[
      {
        name: 'Site terminal',
        description:
          'Explore the blog through directories and commands, including search, reading, and theme switching.',
        links: [{ type: 'site', href: '/terminal/' }]
      },
      {
        name: 'Agent resource collection',
        description:
          'Selected courses, engineering articles, and repositories, each with a reason to read it.',
        links: [{ type: 'doc', href: '/en/curated/' }]
      }
    ]}
  />

  <p>
    Visit my <a href={profileLinks.github}>GitHub profile</a> for public repositories, or use <a
      href={profileLinks.issues}>repository Issues</a
    > to report a problem with this site.
  </p>

  <h2 id='credits'>Open-source foundation</h2>
  <ProjectSection
    project={[
      {
        name: 'Astro Theme Pure',
        description: 'The open-source theme foundation used by this blog.',
        links: [
          { type: 'github', href: 'https://github.com/cworld1/astro-theme-pure' },
          { type: 'site', href: 'https://astro-pure.js.org/' }
        ]
      }
    ]}
  />
</PageLayout>
