---
import { profileLinks } from '@/data/profile'

import PageLayout from '@/layouts/CommonPage.astro'

const headings = [
  { depth: 2, slug: 'channels', text: 'Public channels' },
  { depth: 2, slug: 'before-writing', text: 'Reporting a problem' }
]

const channels = [
  {
    name: 'GitHub profile',
    href: profileLinks.github,
    note: 'My public account and repositories.'
  },
  {
    name: 'Blog feedback',
    href: profileLinks.issues,
    note: 'Report broken links, page problems, or content corrections.'
  },
  { name: 'Personal blog', href: '/en', note: 'Return to posts, notes, and curated resources.' },
  { name: 'RSS feed', href: '/rss.xml', note: 'Subscribe to blog posts in a feed reader.' }
]
---

<PageLayout title='Contact' {headings}>
  <p>
    GitHub is the current public feedback channel. Please use this blog's repository Issues for
    site-related questions.
  </p>

  <h2 id='channels'>Public channels</h2>
  <ul>
    {
      channels.map((item) => (
        <li>
          <a
            href={item.href}
            target={item.href.startsWith('https://') ? '_blank' : undefined}
            rel={item.href.startsWith('https://') ? 'noopener noreferrer' : undefined}
          >
            {item.name}
          </a>
          <span> — {item.note}</span>
        </li>
      ))
    }
  </ul>

  <h2 id='before-writing'>Reporting a problem</h2>
  <p>
    Include the page URL, a description of the problem, and steps to reproduce it. For a correction,
    identify the passage and any supporting source.
  </p>
</PageLayout>
