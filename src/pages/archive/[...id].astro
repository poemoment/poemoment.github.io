---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import PageLayout from '@/layouts/ContentLayout.astro'
import PageInfo from '@/components/comment/PageInfo.astro'
import TOC from '@/components/toc/TOC.astro'
import { Button, Icon } from 'astro-pure/user'

export const prerender = true

export async function getStaticPaths() {
  const archives = await getCollection('archive', ({ data }) => !data.draft)
  return archives.map((entry) => ({ params: { id: entry.id }, props: { entry } }))
}

type Props = { entry: CollectionEntry<'archive'> }
const { entry } = Astro.props
const { Content, headings } = await render(entry)
const { title, description, date, updatedDate, tags, status, relatedBlog = [], relatedArchive = [], source } = entry.data
const chapterHeadings = headings.filter(({ depth, text }) => depth > 1 && text.trim())
const statusLabels = {
  'in-progress': '整理中',
  incomplete: '待补充',
  ready: '整理完成',
  archived: '已归档'
}
const statusNotes = {
  'in-progress': '这篇随记仍在整理，后续可能补充或修订。',
  incomplete: '这篇随记尚有待补充的内容。',
  ready: '整理完成 · 适用范围与未解决问题以正文说明为准。',
  archived: '这篇随记已归档，使用时请留意发布时间与适用条件。'
}
const formatDate = (value: Date) => value.toLocaleDateString('zh-CN', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'Asia/Shanghai'
})
const [blogPosts, archives] = await Promise.all([
  getCollection('blog', ({ data }) => !data.draft),
  getCollection('archive', ({ data }) => !data.draft)
])
const overlap = (otherTags: string[]) => otherTags.filter((tag) => tags.includes(tag)).length
const recommendations = [
  ...blogPosts.map((post) => ({
    id: post.id, title: post.data.title, description: post.data.description,
    href: `/blog/${post.id}/`, kind: '文章', date: post.data.publishDate,
    explicit: relatedBlog.includes(post.id), overlap: overlap(post.data.tags)
  })),
  ...archives.filter((archive) => archive.id !== entry.id).map((archive) => ({
    id: archive.id, title: archive.data.title, description: archive.data.description,
    href: `/archive/${archive.id}/`, kind: '随记', date: archive.data.date,
    explicit: relatedArchive.includes(archive.id), overlap: overlap(archive.data.tags)
  }))
].filter((item) => item.explicit || item.overlap > 0)
  .sort((a, b) => Number(b.explicit) - Number(a.explicit) || b.overlap - a.overlap || b.date.getTime() - a.date.getTime() || a.href.localeCompare(b.href))
  .slice(0, 2)

const meta = { title, description: description || title }
---

<PageLayout {meta} back='/archive/'>
  {chapterHeadings.length >= 2 && <TOC headings={chapterHeadings} slot='sidebar' />}
  <div slot='header' class='animate gap-y-4'>
    <div class='mb-3 flex flex-wrap items-center gap-2 text-sm text-muted-foreground'>
      <span class='note-status'><span aria-hidden='true'></span>{statusLabels[status]}</span>
      {tags.map((tag) => (
        <a href={`/archive/tags/${encodeURIComponent(tag)}/`}
          class='rounded-md border border-border px-2 py-1 transition hover:border-foreground/20'>
          {tag}
        </a>
      ))}
    </div>
    <h1 class='mb-4 text-3xl font-bold leading-tight sm:text-4xl'>{title}</h1>
    {description && <p class='text-lg text-muted-foreground'>{description}</p>}
    <PageInfo class='mt-2 italic' path={`/archive/${entry.id}/`} />
    <div class='mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted-foreground'>
      <div class='flex items-center gap-2'>
        <Icon name='calendar' />
        <span>发布于 <time datetime={date.toISOString()}>{formatDate(date)}</time></span>
      </div>
      {updatedDate && updatedDate.getTime() > date.getTime() && (
        <span>更新于 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
      )}
    </div>
    {source && (
      <div class='mt-4 flex items-start gap-2 rounded-lg bg-muted/50 p-3 text-sm'>
        <span class='shrink-0 text-muted-foreground'>原始来源</span>
        <a href={source} target='_blank' rel='noopener noreferrer' class='min-w-0 break-words hover:underline'>{source}</a>
      </div>
    )}
  </div>

  <Content />

  <div slot='bottom' class='note-bottom animate border-t border-border pt-6'>
    {recommendations.length > 0 && (
      <section aria-labelledby='continue-reading'>
        <h2 id='continue-reading' class='mb-4 text-lg font-semibold text-foreground'>继续阅读</h2>
        <ul class='next-reading'>
          {recommendations.map((item) => (
            <li>
              <a href={item.href} class='next-reading-card' data-astro-prefetch>
                <span class='next-reading-kind'>{item.explicit ? `关联${item.kind}` : `同主题${item.kind}`}</span>
                <span class='font-medium text-foreground'>{item.title}</span>
                {item.description && <span class='next-reading-description'>{item.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <div class='note-footer'>
      <p class='text-sm text-muted-foreground'>{statusNotes[status]}</p>
      <Button title='返回随记' href='/archive/' style='back' />
    </div>
  </div>
</PageLayout>

<style>
  .note-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    border-radius: 0.5rem;
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
  }
  .note-status > span {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 50%;
    background: hsl(var(--primary));
  }
  .next-reading {
    display: grid;
    gap: 0.75rem;
  }
  .next-reading-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1rem;
    border: 1px solid hsl(var(--border));
    border-radius: 0.9rem;
    background: hsl(var(--card));
    transition: border-color 150ms;
  }
  .next-reading-card:hover { border-color: hsl(var(--primary) / 0.55); }
  .next-reading-card:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 3px;
  }
  .next-reading-kind { font-size: 0.75rem; }
  .next-reading-description { font-size: 0.875rem; line-height: 1.7; }
  .note-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid hsl(var(--border));
  }
  @media (min-width: 640px) {
    .next-reading { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
