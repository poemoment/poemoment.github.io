---
import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

// Plugin styles
import 'katex/dist/katex.min.css'

import { MediumZoom } from 'astro-pure/advanced'
import { ArticleBottom, Hero, TOC } from 'astro-pure/components/pages'
import PageLayout from '@/layouts/ContentLayout.astro'
import Comment from '@/components/comment/Comment.astro'
import Copyright from '@/components/pages/Copyright.astro'
import HeroEn from '@/components/HeroEn.astro'
import { integ } from '@/site-config'

interface Props {
  post: CollectionEntry<'blog' | 'blogEn'>
  posts: CollectionEntry<'blog' | 'blogEn'>[]
  headings: MarkdownHeading[]
  remarkPluginFrontmatter: Record<string, unknown>
  back?: string
  recommend?: boolean
  enHero?: boolean
}

const {
  post: { id, data },
  posts,
  headings,
  remarkPluginFrontmatter,
  back = '/blog',
  recommend = true,
  enHero = false
} = Astro.props

const {
  description,
  publishDate,
  title,
  updatedDate
} = data

// English mirrors (id ends in `.en`) reuse the Chinese post's OG image.
const socialImage = `/og/blog/${id.replace(/\.en$/, '')}.png`
const articleDate = updatedDate?.toISOString() ?? publishDate.toISOString()
---

<PageLayout
  meta={{ articleDate, description, ogImage: socialImage, title }}
  back={back}
  showProgress
>
  {!!headings.length && <TOC {headings} slot='sidebar' />}

  {
    enHero ? (
      <HeroEn {data} {remarkPluginFrontmatter} slot='header' />
    ) : (
      <Hero {data} {remarkPluginFrontmatter} slot='header' />
    )
  }

  <slot />

  {/* 方案 B：修订信息与未解决问题 —— 仅在 frontmatter 提供时渲染，不做成模板化总结 */}
  {(data.status || data.openQuestions?.length) && (
    <aside class='article-appendix animate'>
      {data.status && <p class='appendix-status'>本文状态：{data.status}</p>}
      {data.openQuestions?.length && (
        <div class='appendix-questions'>
          <h2>尚未解决的问题</h2>
          <ul>
            {data.openQuestions.map((question: string) => (
              <li>{question}</li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  )}

  <Fragment slot='bottom'>
    {/* Copyright */}
    <Copyright {data} />
    {/* Article recommend */}
    {recommend && <ArticleBottom collections={posts} {id} class='mt-3 sm:mt-6' />}
    {/* Comments */}
    {data.comment && <Comment class='mt-6' />}
  </Fragment>

  <slot name='bottom-sidebar' slot='bottom-sidebar' />
</PageLayout>

{integ.mediumZoom.enable && <MediumZoom />}

<style>
  /* 文末附录：规则线结构，不用卡片 */
  .article-appendix {
    margin-top: 3.5rem;
    border-top: 1px solid hsl(var(--border));
    padding-top: 1.25rem;
  }

  .appendix-status {
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .appendix-questions h2 {
    margin: 1.25rem 0 0.5rem;
    font-size: 1.05rem;
    font-weight: 650;
  }

  .appendix-questions ul {
    margin: 0;
    color: hsl(var(--muted-foreground));
    line-height: 1.8;
  }
</style>
