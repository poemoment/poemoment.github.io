---
import type { SiteMeta } from 'astro-pure/types'
import { Button, Icon } from 'astro-pure/user'
import { cn } from 'astro-pure/utils'
import PageLayout from '@/layouts/BaseLayout.astro'
import BackToTop from '@/components/pages/BackToTop.astro'
import { integ } from '@/site-config'

interface Props {
  meta: SiteMeta
  highlightColor?: string
  back?: string
  /** 阅读进度与目录独立，短随记也可以有章节导航。 */
  showProgress?: boolean
}

const { meta, highlightColor, back = '/', showProgress = false, ...props } = Astro.props
const isEn = Astro.url.pathname.startsWith('/en')
const sidebarHTML = await Astro.slots.render('sidebar')
// Empty TOCs can still emit their component script; neither should reserve a column.
const hasSidebar = Boolean(sidebarHTML?.replace(/<script\b[^>]*>[\s\S]*?<\/script>/gi, '').replace(/<!--[\s\S]*?-->/g, '').trim())
const hasBottomSidebar = Astro.slots.has('bottom-sidebar')
---

<PageLayout {meta} {highlightColor} {...props}>
  <Button title={isEn ? 'Back' : '返回'} href={back} style='back' />
  <main class:list={['reading-layout mt-6', { 'has-sidebar': hasSidebar }]}>
    {
      hasSidebar && (
        <aside class='reading-sidebar' aria-label={isEn ? 'Article navigation' : '正文导航'}>
          <details id='sidebar' open>
            <summary class='chapter-toggle'>
              <span><Icon name='list' />{isEn ? 'On this page' : '本页目录'}</span>
              <span class='chapter-chevron' aria-hidden='true'>⌄</span>
            </summary>
            <div class='chapter-list'><Fragment set:html={sidebarHTML} /></div>
          </details>
        </aside>
      )
    }

    <article class='reading-article min-w-0'>
      <div id='content-header' class='animate'>
        <slot name='header' />
      </div>
      <div
        id='content'
        class={cn('reading-paper min-w-0 animate mt-8 overflow-x-hidden', integ.typography.class)}
      >
        <slot />
      </div>
    </article>
  </main>

  <div class:list={['reading-bottom mt-6', { 'has-sidebar': hasSidebar }]}>
    <div class='mt-8 min-w-0 text-muted-foreground'>
      <slot name='bottom' />
    </div>
    {hasBottomSidebar && <div class='min-w-0'><slot name='bottom-sidebar' /></div>}
  </div>

  {showProgress && <BackToTop header='content-header' content='content' />}
</PageLayout>

<script>
  const chapters = document.querySelector<HTMLDetailsElement>('#sidebar')
  if (chapters) {
    const summary = chapters.querySelector<HTMLElement>('summary')
    const desktop = window.matchMedia('(min-width: 1024px)')
    const synchronize = () => {
      const focusInside = chapters.contains(document.activeElement)
      chapters.open = desktop.matches
      if (!desktop.matches && focusInside) summary?.focus({ preventScroll: true })
    }
    synchronize()
    desktop.addEventListener('change', synchronize)
    chapters.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !desktop.matches && chapters.open) {
        event.preventDefault()
        chapters.open = false
        summary?.focus({ preventScroll: true })
      }
    })
    // TOC moves focus to the selected heading; closing this disclosure does not trap focus.
    chapters.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null
      if (!desktop.matches && target?.closest('a[href^="#"]')) chapters.open = false
    })
  }
</script>

<style>
  .reading-layout,
  .reading-bottom {
    max-width: 70ch;
    margin-inline: auto;
  }
  .reading-sidebar {
    margin-bottom: 1.5rem;
  }
  #content :global(:is(h2, h3, h4, h5, h6)) {
    scroll-margin-top: 6rem;
  }
  .chapter-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    padding: 0.8rem 1rem;
    list-style: none;
    color: hsl(var(--foreground));
    font-size: 0.875rem;
    font-weight: 600;
  }
  .chapter-toggle::-webkit-details-marker { display: none; }
  .chapter-toggle > span:first-child {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .chapter-toggle:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 3px;
    border-radius: 0.75rem;
  }
  details {
    border: 1px solid hsl(var(--border));
    border-radius: 0.85rem;
    background: hsl(var(--card));
  }
  details[open] .chapter-chevron { transform: rotate(180deg); }
  .chapter-list {
    padding: 0 0.75rem 1rem;
    max-height: min(60vh, 28rem);
    overflow-y: auto;
  }
  .chapter-list :global(toc-heading > h2) { display: none; }
  .chapter-list :global(toc-heading ul) { margin-top: 0; }
  @media (min-width: 1024px) {
    .has-sidebar {
      max-width: none;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 15rem;
      align-items: start;
      column-gap: 2.5rem;
    }
    .reading-sidebar {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      top: 5rem;
      margin-bottom: 0;
    }
    .reading-article {
      grid-column: 1;
      grid-row: 1;
    }
    .chapter-toggle { display: none; }
    details {
      border: 0;
      background: transparent;
    }
    .chapter-list {
      padding: 0;
      max-height: calc(100dvh - 7rem);
    }
    .chapter-list :global(toc-heading > h2) { display: block; }
    .chapter-list :global(toc-heading > nav > ul) { margin-top: 1rem; }
  }
</style>
